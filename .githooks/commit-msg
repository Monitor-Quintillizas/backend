#!/bin/sh
# Turns "#10" in the commit message into "<ISSUES_REPO>#10", so the commit
# shows up in the issue even though the issues live in another repository.
# References that already name a repository are left as they are.
ISSUES_REPO="Monitor-Quintillizas/fronted"

sed -E "s|(^\|[^A-Za-z0-9_./-])#([0-9]+)|\1${ISSUES_REPO}#\2|g" "$1" > "$1.tmp" && mv "$1.tmp" "$1"
